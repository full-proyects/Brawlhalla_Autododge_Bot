// XPE Bot - resource file: version info shown in Explorer Properties.
#include <winver.h>

#define VER_FILEVERSION             2,0,4,0
#define VER_FILEVERSION_STR         "2.0.4.0\0"
#define VER_PRODUCTVERSION          2,0,4,0
#define VER_PRODUCTVERSION_STR      "2.0.4.0\0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "xpe.nettt"
            VALUE "FileDescription",  "XPE Bot"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "XPEBot"
            VALUE "LegalCopyright",   "Copyright (c) 2026 xpe.nettt"
            VALUE "OriginalFilename", "XPEBot.exe"
            VALUE "ProductName",      "XPE Bot"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
